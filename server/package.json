{
  "name": "server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../.env src/index.ts",
    "start": "tsx --env-file-if-exists=../.env src/index.ts",
    "extract": "tsx --env-file-if-exists=../.env src/cli/extract.ts",
    "eval": "tsx --env-file-if-exists=../.env src/cli/eval.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@hono/node-server": "^2.1.1",
    "@recipe/shared": "^0.0.0",
    "hono": "^4.13.9",
    "nanoid": "^3.3.19",
    "zod": "^4.6.5"
  }
}
