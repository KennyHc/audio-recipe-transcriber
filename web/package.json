{
  "name": "web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:browser": "VITE_BACKEND=browser vite",
    "build": "tsc --noEmit && vite build",
    "build:browser": "VITE_BACKEND=browser tsc --noEmit && VITE_BACKEND=browser vite build",
    "typecheck": "tsc --noEmit",
