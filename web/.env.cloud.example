# Config for the signed-in cloud build: `npm run dev:cloud` / `npm run build:cloud`
# (vite --mode cloud loads `.env.cloud` and `.env.cloud.local` automatically).
#
#   cp .env.cloud.example .env.cloud.local    # then fill in your project's values
#
# Everything here is PUBLIC by design and ends up in the bundle: the Firebase web config only
# identifies the project — access is enforced by Firebase Auth, App Check and
# firebase/firestore.rules. Never put the Anthropic key here; it lives only in the API's
# Secret Manager secret (see api/).

# Firebase console → Project settings → Your apps → Web app → SDK setup and configuration
VITE_FIREBASE_API_KEY=your-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000

# Firebase console → App Check → your web app → reCAPTCHA Enterprise site key
VITE_APPCHECK_SITE_KEY=your-recaptcha-enterprise-site-key

# The Cloud Run API (api/). Locally: `npm run dev -w api` (serves on :8080).
VITE_API_BASE=http://localhost:8080

# Local development against the Firebase emulators (`npm run emulators -w firebase-config`):
# Auth on :9099, Firestore on :8085, project "demo-recipe", and an App Check debug token
# instead of reCAPTCHA. With this on, the VITE_FIREBASE_* values above may stay placeholders.
VITE_USE_EMULATORS=false
# VITE_EMULATOR_PROJECT_ID=demo-recipe
# VITE_FIRESTORE_EMULATOR_PORT=8085
# VITE_AUTH_EMULATOR_PORT=9099
