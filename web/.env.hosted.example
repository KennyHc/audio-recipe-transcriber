# Local config for `npm run build:hosted` / `npm run dev:hosted` / `npm run preview:hosted`
# (vite --mode hosted loads `.env.hosted` automatically — see https://vitejs.dev/guide/env-and-mode).
#
# Copy this file to `.env.hosted` (same directory) and point it at your local Worker:
#   cp .env.hosted.example .env.hosted
#
# Both values are PUBLIC by design — never put the Anthropic key here, it belongs only in the
# Worker's Cloudflare secrets (see worker/). VITE_TURNSTILE_SITE_KEY below is Cloudflare's
# published "always passes" test site key, safe to use against any hostname for local dev —
# swap it for the real site key in a production .env.hosted (not committed; see note in
# web/CLAUDE.md-adjacent docs / ask the lead if this repo's .gitignore needs a `.env*` entry).

VITE_API_BASE=http://localhost:8788
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
