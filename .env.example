# How the extractor/verifier reach Claude:
#   cli = your local Claude Code login (subscription) — personal, local use only
#   api = Anthropic API, needs ANTHROPIC_API_KEY
CLAUDE_BACKEND=cli
# CLAUDE_CLI=/Users/you/.local/bin/claude   # only if `claude` isn't on the server's PATH
ANTHROPIC_API_KEY=
# Path to a whisper.cpp ggml model (run `npm run setup:whisper` to download one)
WHISPER_MODEL=./models/ggml-large-v3-turbo.bin
# Models per agent
EXTRACTOR_MODEL=claude-sonnet-5
VERIFIER_MODEL=claude-haiku-4-5
API_PORT=8787
