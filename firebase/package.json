{
  "name": "firebase-config",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "firebase emulators:exec --only firestore --project demo-recipe \"vitest run\"",
    "emulators": "firebase emulators:start --only auth,firestore --project demo-recipe",
    "deploy:rules": "firebase deploy --only firestore:rules,firestore:indexes"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@recipe/shared": "^0.0.0",
    "firebase": "^13.0.0",
    "firebase-tools": "^15.33.0",
    "vitest": "^3.2.7"
  }
}
